#%%
import sys
from pathlib import Path

import numpy as np
from rich.console import Console
from rich.table import Table

# Ensure project root and src/ are on sys.path so `core` and `service` import cleanly
PROJECT_ROOT = Path("..").resolve()
SRC_DIR = PROJECT_ROOT / "src"
for _p in (SRC_DIR, PROJECT_ROOT):
    if str(_p) not in sys.path:
        sys.path.insert(0, str(_p))

from gosmart_graphite.core.config import Settings
from gosmart_graphite.model.llm import LLM_Config
from gosmart_graphite.service.embedding_service import EmbeddingService, SimilarityMetric
from gosmart_graphite.service.llm_config_service import llm_config_service

console = Console()
env_file = PROJECT_ROOT / ".env"
settings = Settings(_env_file=str(env_file) if env_file.exists() else None)
llm_cfg = await llm_config_service.resolve_config_for_group(tag="embedding")
if llm_cfg is None:
    llm_cfg = LLM_Config(
        tag="embedding",
        provider="ollama",
        model="nomic-embed-text:latest",
        url="http://localhost:11434",
        dimensions=768,
    )
vector_service = EmbeddingService(config=llm_cfg, settings=settings)

print(f"Provider   : {vector_service.resolve_provider()}")
print(f"Embedder   : {vector_service.resolve_embedder_name()}")
print(f"Server URL : {llm_cfg.url or '-'}")
print(f"Dimensions : {llm_cfg.dimensions}")
