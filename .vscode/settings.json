{
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
        // Prevents VS Code from saving mid-generation and triggering a rollback
    "files.autoSave": "off", 
    
    // Disables formatters from modifying the temporary diff buffer
    "editor.formatOnSave": false,
    
    // Optional: Keeps formatters active normally, but explicitly disables them for the language you code in most (e.g., Python)
    "[python]": {
        "editor.formatOnSave": false
    },
    "cSpell.words": [
        "abfs",
        "acse",
        "blackbox",
        "dcmread",
        "dicom",
        "dicomweb",
        "dimse",
        "gosmart",
        "MDICOM",
        "Pydantic",
        "pydicom",
        "pykka",
        "pynetdicom",
        "pyproject",
        "pytest",
        "QIDO",
        "REASSOCIATED",
        "uids",
        "unconfigured",
        "Uvicorn",
        "WADO"
    ],
    "rest-client.environmentVariables": {
        "$shared": {
            "graphServer": "http://localhost:8086",
            "adminUsername": "admin",
            "adminPassword": "MySecurePassword123!"
        },
        "local": {
            "graphServer": "http://localhost:8000"
        },
        "docker": {
            "graphServer": "http://localhost:8086"
        }
    }
}