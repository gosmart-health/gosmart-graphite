# ==============================================================================
# GoSmart DICOM Graph Server Environment Configuration
# Prefix: GOSMART_GS_
# ==============================================================================

# Database Connection (Neo4j)
GOSMART_GS_DB_CONNECTION_URI=bolt://localhost:7687
GOSMART_GS_DB_USER=neo4j
GOSMART_GS_DB_PASSWORD=password
GOSMART_GS_DB_DATABASE=neo4j

# Storage Root URI for DICOM files
GOSMART_GS_STORAGE_ROOT_URI=file:///tmp/gosmart_dicom_storage

# Server Network & Host Binding
GOSMART_GS_HOST=0.0.0.0
GOSMART_GS_PORT=8000
GOSMART_GS_RELOAD=true

# Logging Configuration (Industrial Strength structlog & 7-Day Auto-Rotation)
GOSMART_GS_LOG_LEVEL=INFO
GOSMART_GS_LOG_FORMAT=json
GOSMART_GS_LOG_DIR=./logs
GOSMART_GS_LOG_FILE=gosmart_gs.log
GOSMART_GS_LOG_ROTATION_DAYS=7
GOSMART_GS_LOG_BACKUP_COUNT=8
GOSMART_GS_LOG_TO_FILE=true

# DICOM Network Configuration (pynetdicom)
GOSMART_GS_DICOM_AE_TITLE=GOSMART_GS
GOSMART_GS_DICOM_SCP_PORT=11112
