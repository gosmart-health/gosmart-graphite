# ==============================================================================
# GoSmart DICOM Graph Server Environment Configuration
# Prefix: GOSMART_GS_
# ==============================================================================

GOSMART_GS_INITIAL_ADMIN_EMAIL=admin@gosmart.health
GOSMART_GS_INITIAL_ADMIN_PASSWORD=MySecurePassword123!
GOSMART_GS_INITIAL_ADMIN_USERNAME=admin
# GOSMART_GS_FORCE_ADMIN_PASSWORD_RESET=true

# Database Connection (Neo4j)
GOSMART_GS_DB_CONNECTION_URI=bolt://localhost:7687
GOSMART_GS_DB_USER=neo4j
GOSMART_GS_DB_PASSWORD=neo4j
GOSMART_GS_DB_DATABASE=neo4j

# FHIR Integration (Optional - empty root disables FHIR)
GOSMART_GS_FHIR_BASE_URL=
GOSMART_GS_FHIR_POLL_SEC=120
GOSMART_GS_FHIR_ACCESSION_SYSTEM=urn:oid:2.16.840.1.113883.4.3.25
GOSMART_GS_FHIR_PATIENT_ID_SYSTEM=urn:oid:2.16.840.1.113883.4.3.25

# Storage Root URI for DICOM files
GOSMART_GS_STORAGE_ROOT_URI=file:///tmp/gosmart_dicom_storage

# Server Network & Host Binding
GOSMART_GS_HOST=0.0.0.0
GOSMART_GS_PORT=8086
GOSMART_GS_RELOAD=true

# Logging Configuration (Industrial Strength structlog & 7-Day Auto-Rotation)
GOSMART_GS_LOG_LEVEL=INFO
GOSMART_GS_LOG_FORMAT=json
GOSMART_GS_LOG_DIR=./logs
GOSMART_GS_LOG_FILE=gosmart_gs.log
GOSMART_GS_LOG_ROTATION_DAYS=7
GOSMART_GS_LOG_BACKUP_COUNT=8
GOSMART_GS_LOG_TO_FILE=true

# DICOM Network Configuration (pynetdicom)
GOSMART_GS_DICOM_AE_TITLE=GOSMART_GS
GOSMART_GS_DICOM_SCP_PORT=11112

# ==============================================================================
# Cloud Storage Credentials (Optional - can also use standard SDK env vars directly)
# ==============================================================================
# Google Cloud Storage (GCS)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GCS_ENDPOINT_URL=http://localhost:4443

# Amazon S3
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL=http://localhost:9000

# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
# AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
# AZURE_STORAGE_ACCOUNT_KEY=your-account-key
